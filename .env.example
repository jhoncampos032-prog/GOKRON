# Copia este archivo como ".env" (en la misma carpeta que docker-compose.yml)
# y rellena los valores. El archivo ".env" NUNCA se sube a GitHub.

# Contrasena de la base de datos. Usa solo letras y numeros (sin simbolos), por ejemplo:
#   openssl rand -hex 24
DB_PASSWORD=

# Llave para firmar las sesiones. Cualquier texto largo y aleatorio:
#   openssl rand -hex 32
JWT_SECRET=

# Direccion publica del panel (la usa el enlace del correo de recuperar contrasena).
#   Con dominio:  https://midominio.com        Sin dominio:  http://IP-DEL-SERVIDOR
FRONTEND_URL=

# Dominio para HTTPS automatico (sin https://). Sin dominio todavia: deja ":80"
DOMINIO=:80

# Puertos (solo cambialos para probar en tu PC si el 80/443 estan ocupados)
HTTP_PORT=80
HTTPS_PORT=443

# Correo de recuperar contrasena (Gmail + "contrasena de aplicacion")
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Radio (Agora)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Google Drive (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CRON_SECRET=
